// Firestore security rules.
//
// CLOUD FUNCTIONS BYPASS THESE RULES via Admin SDK (functions/src/index.ts).
// That's intentional — Apple Shortcuts can't authenticate to Firebase, so
// Siri endpoints look up tokens directly. Treat new Cloud Functions with
// the same care as admin endpoints elsewhere; input validation matters.
//
// See docs/DATA_POLICY.md §10 (one Firestore doc per module per user) +
// §11 (Admin SDK bypass), and docs/DECISIONS.md D-10 (token-based Siri
// auth).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Siri token lookup index
    // Users can only manage tokens that belong to them.
    // Cloud Functions use Admin SDK and bypass these rules entirely.
    match /siriTokens/{token} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'createdAt']);
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
